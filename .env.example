# Overrides for the local infrastructure defined in compose.yaml.
# Copy to .env (git-ignored) only if you need values different from the
# safe local defaults baked into compose.yaml. Never commit real secrets.
#
# Service configuration lives next to each service (apps/*/.env.example),
# not in this file.

HELPDESK_POSTGRES_USER=helpdesk_admin
HELPDESK_POSTGRES_PASSWORD=helpdesk_local_only_pg
HELPDESK_POSTGRES_DB=helpdesk_platform

# Password for the auth_service role that owns helpdesk_auth (and its _test
# database). Applied by infrastructure/postgres/init on first volume init.
HELPDESK_AUTH_DB_PASSWORD=helpdesk_local_only_auth
HELPDESK_TICKETS_DB_PASSWORD=helpdesk_local_only_tickets
HELPDESK_USERS_DB_PASSWORD=helpdesk_local_only_users

HELPDESK_REDIS_PASSWORD=helpdesk_local_only_redis

HELPDESK_RABBITMQ_USER=helpdesk
HELPDESK_RABBITMQ_PASSWORD=helpdesk_local_only_rabbit

# api-gateway — development defaults.
# Copy to .env (git-ignored) to override locally. Nx loads the sibling .env
# automatically when running targets for this project.
NODE_ENV=development
PORT=3002
LOG_LEVEL=info
# Downstream target for /api/auth/* traffic.
AUTH_SERVICE_URL=http://localhost:3003
# Downstream target for /api/tickets/* traffic.
TICKETS_SERVICE_URL=http://localhost:3004
# Downstream target for /api/users/* traffic.
USERS_SERVICE_URL=http://localhost:3005

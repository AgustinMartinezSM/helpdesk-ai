# web-bff — development defaults.
# Copy to .env (git-ignored) to override locally. Nx loads the sibling .env
# automatically when running targets for this project.
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# Comma-separated list of browser origins allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Platform entry point; the BFF never calls domain services directly.
GATEWAY_URL=http://localhost:3002
# Set to true wherever the BFF is served over https.
SESSION_COOKIE_SECURE=false
# Browser lifetime of the httpOnly refresh cookie (seconds).
SESSION_REFRESH_COOKIE_MAX_AGE_SECONDS=1209600

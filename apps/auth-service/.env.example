# auth-service — development defaults.
# Copy to .env (git-ignored) and replace placeholder secrets. Nx loads the
# sibling .env automatically when running targets for this project; the
# Prisma CLI reads DATABASE_URL from the shell environment.
NODE_ENV=development
PORT=3003
LOG_LEVEL=info

# Owned database (ADR 0003). The auth_service role is provisioned by
# infrastructure/postgres/init on first volume initialization.
DATABASE_URL=postgresql://auth_service:helpdesk_local_only_auth@localhost:5433/helpdesk_auth

# Local RabbitMQ from compose.yaml; user.registered.v1 is published here.
RABBITMQ_URL=amqp://helpdesk:helpdesk_local_only_rabbit@localhost:5672

# REQUIRED, no default: startup fails without it. Use a long random string,
# e.g. in PowerShell:  -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# Membership is resolved here while a token is minted (ADR 0014), directly
# rather than through the api-gateway.
ORGANIZATIONS_SERVICE_URL=http://localhost:3010

# Identifies this process to organizations-service; MUST equal that service's
# INTERNAL_SERVICE_TOKEN. Optional and with no default on purpose — a default
# would ship a guessable credential. Leave it unset and tokens are minted
# without tenant claims, which is what every service already expects.
INTERNAL_SERVICE_TOKEN=replace-with-a-random-string-of-at-least-32-characters

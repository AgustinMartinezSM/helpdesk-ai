# auth-service — development defaults.
# Copy to .env (git-ignored) and replace placeholder secrets. Nx loads the
# sibling .env automatically when running targets for this project; the
# Prisma CLI reads DATABASE_URL from the shell environment.
NODE_ENV=development
PORT=3003
LOG_LEVEL=info

# Owned database (ADR 0003). The auth_service role is provisioned by
# infrastructure/postgres/init on first volume initialization.
DATABASE_URL=postgresql://auth_service:helpdesk_local_only_auth@localhost:5433/helpdesk_auth

# REQUIRED, no default: startup fails without it. Use a long random string,
# e.g. in PowerShell:  -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# web — development defaults.
# Copy to .env (git-ignored) to override locally. Nx loads the sibling .env
# automatically when running targets for this project.

# Browser-facing API. The web app never calls domain services directly.
NEXT_PUBLIC_BFF_URL=http://localhost:3001

# Public-site links. Each one renders ONLY when set: the site must never
# ship a dead link, so leaving a value empty hides its UI entirely.
NEXT_PUBLIC_GITHUB_URL=https://github.com/AgustinMartinezSM/helpdesk-ai
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_CONTACT_EMAIL=

# Canonical site URL, used for metadata. Only meaningful once deployed.
NEXT_PUBLIC_SITE_URL=

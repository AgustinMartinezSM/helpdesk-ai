# organizations-service — development defaults.
# Copy to .env (git-ignored) and replace the secret placeholders. Nx loads the
# sibling .env automatically; the Prisma CLI reads DATABASE_URL from the shell.
NODE_ENV=development
PORT=3010
LOG_LEVEL=info

# Owned database (ADR 0003), provisioned by infrastructure/postgres/init.
DATABASE_URL=postgresql://organizations_service:helpdesk_local_only_organizations@localhost:5433/helpdesk_organizations

# Local RabbitMQ from compose.yaml; user.registered.v1 is consumed from here.
RABBITMQ_URL=amqp://helpdesk:helpdesk_local_only_rabbit@localhost:5672

# Credential auth-service presents on /internal/* when it resolves membership
# while minting a token. MUST equal auth-service's INTERNAL_SERVICE_TOKEN.
#
# There is no JWT_ACCESS_SECRET here, unlike every other service: this one has
# no person-facing endpoint, so it verifies no access tokens. A process
# identity and a person identity are kept on separate secrets on purpose.
INTERNAL_SERVICE_TOKEN=replace-with-a-32-char-minimum-shared-secret

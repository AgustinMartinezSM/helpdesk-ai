# organizations-service — development defaults.
# Copy to .env (git-ignored) and replace the secret placeholders. Nx loads the
# sibling .env automatically; the Prisma CLI reads DATABASE_URL from the shell.
NODE_ENV=development
PORT=3010
LOG_LEVEL=info

# Owned database (ADR 0003), provisioned by infrastructure/postgres/init.
DATABASE_URL=postgresql://organizations_service:helpdesk_local_only_organizations@localhost:5433/helpdesk_organizations

# Local RabbitMQ from compose.yaml; user.registered.v1 is consumed from here.
RABBITMQ_URL=amqp://helpdesk:helpdesk_local_only_rabbit@localhost:5672

# Verification only — this service never signs. It gained a person-facing
# surface in Sprint 9.8 (invitations, routed at /api/organizations), so it now
# reads access tokens like every other service. MUST equal auth-service's
# JWT_ACCESS_SECRET.
JWT_ACCESS_SECRET=replace-with-a-32-char-minimum-secret

# Credential auth-service and tickets-service present on /internal/*. MUST
# equal theirs. Deliberately a different secret from JWT_ACCESS_SECRET even
# now that both live here: one key standing for both "this person is
# authenticated" and "this process is authenticated" would tie their rotations
# together.
INTERNAL_SERVICE_TOKEN=replace-with-a-32-char-minimum-shared-secret

# The value being rotated OUT. Leave unset except during a rotation, when it
# holds the old secret so callers can be moved over one at a time. There is no
# default on purpose — a default would be a second guessable credential. The
# runbook is in SECURITY.md.
# INTERNAL_SERVICE_TOKEN_PREVIOUS=

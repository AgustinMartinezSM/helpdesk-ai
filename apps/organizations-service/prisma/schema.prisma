// Persistence model for organizations-service. Maps to PERSISTENCE shapes
// only; domain entities live in src/domain and are mapped inside the
// repository adapter (ADR 0004).
//
// Unlike the projections in users-service, notification-service and
// analytics-service, this data is NOT rebuildable from the event log: losing
// a membership locks a person out of an organization (ADR 0013). Treat every
// row here as a source of truth.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String   @id @db.Uuid
  slug      String   @unique
  name      String
  status    String
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  memberships  Membership[]
  branches     Branch[]
  invitations  Invitation[]
  supportTeams SupportTeam[]

  @@map("organizations")
}

// A redeemable offer of membership (Sprint 9.8, ADR 0019). It is not an
// account and not a credential for one: redeeming it requires already being
// authenticated as the addressed person, and the password that person logs in
// with is theirs, created by them, never seen by the admin who invited them.
//
// Lives here because redemption must consume the code and insert the
// membership below in one transaction — there is no outbox (ADR 0006), so a
// split write can burn a code whose secret nothing can regenerate.
model Invitation {
  id String @id @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Normalized (trimmed, lowercased) at the boundary; matched against the
  // `email` claim of the person redeeming, never against a request body.
  inviteeEmail String @map("invitee_email")

  // A plain string key, like Membership.roleTemplate and for the same reason
  // (ADR 0015): the template vocabulary is not settled.
  roleTemplate String @map("role_template")
  status       String

  // sha256 of the code's secret half. The code itself is never stored, never
  // logged and never put in an event — it exists in exactly one HTTP
  // response. That also means this row is NOT reconstructible: no reissue
  // path can exist, which data-ownership.md records.
  codeHash String @map("code_hash")

  invitedByUserId String   @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(3)

  /// Where the invited person will work, carried from a CSV import (Sprint
  /// 9.15) and applied at redemption inside the transaction that inserts the
  /// membership. Real foreign keys, unlike every cross-service id in this
  /// platform, because branches live in THIS database (ADR 0013) — which is
  /// what lets the database refuse a department that does not belong to the
  /// branch beside it rather than trusting the importer to have checked.
  ///
  /// Nullable forever: the single-invitation form leaves both null, and an
  /// organization with no branches has nowhere to place anybody.
  /// ON DELETE SET NULL, not CASCADE: archiving or removing a branch must not
  /// silently destroy a pending invitation somebody is waiting to redeem.
  branchId String? @map("branch_id") @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  acceptedByUserId String?   @map("accepted_by_user_id") @db.Uuid
  acceptedAt       DateTime? @map("accepted_at") @db.Timestamptz(3)

  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  // The "one pending invitation per address" rule is a PARTIAL unique index
  // (WHERE status = 'pending'), which Prisma's schema language cannot
  // express — it is raw SQL in the migration. Declared here as a plain index
  // so the generated client still plans lookups well; the uniqueness lives in
  // the database, where a concurrent second issue is refused rather than
  // racing a prior read.
  @@index([organizationId, inviteeEmail])
  @@index([organizationId, status, createdAt])
  @@map("invitations")
}

model Membership {
  id String @id @db.Uuid

  // A real intra-service foreign key. ADR 0013 put the whole organizational
  // graph in one database precisely so these edges are enforceable.
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // userId is the identifier auth-service issued in user.registered.v1 —
  // an opaque id, never a cross-service foreign key (ADR 0003).
  userId String @map("user_id") @db.Uuid

  // A plain string key until role templates become seeded rows with their
  // permission mappings (ADR 0015). The evaluator lands with the read-path
  // migration, not here.
  roleTemplate String @map("role_template")
  status       String

  // Membership version carried as the `mv` token claim (ADR 0014). Bumped by
  // the membership lifecycle so an operation that cannot tolerate a stale
  // claim can compare versions instead of trusting the token's snapshot.
  version Int @default(1)

  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  branchMemberships      BranchMembership[]
  departmentMemberships  DepartmentMembership[]
  supportTeamMemberships SupportTeamMembership[]
  responsibleFor         OperationalStation[]

  // "One owner per organization" is a PARTIAL unique index
  // (WHERE role_template = 'owner'), which Prisma's schema language cannot
  // express — it is raw SQL in 20260804120000_single_organization_owner.
  //
  // Do NOT write it here as @@unique([organizationId]): that would generate a
  // TOTAL unique index and allow one member per organization. It is also not
  // declared as a plain @@index, because the partial index already plans the
  // owner lookup and a second index over the same column would be dead weight
  // on every membership write.
  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

// A branch is a SCOPE (ADR 0016): it constrains what a person may see, so it
// is an authorization input and lives in this database next to memberships,
// where the edges below are enforceable foreign keys (ADR 0013).
model Branch {
  id String @id @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Stable operator-facing key, unique per organization; never globally —
  // every chain has a "store-1".
  code   String
  name   String
  status String

  // IANA zone name, nullable: a single-site organization inherits nothing
  // from an unset zone, and inventing one would be wrong more often than
  // helpful.
  timezone String?
  address  String?

  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  departments        Department[]
  stations           OperationalStation[]
  branchMemberships  BranchMembership[]
  supportTeamScopes  SupportTeamBranch[]
  invitations        Invitation[]

  @@unique([organizationId, code])
  @@map("branches")
}

// A department is the REQUESTER'S organizational area (ADR 0016), which is
// why it belongs to exactly one branch. It is not the group that resolves a
// ticket — that is SupportTeam above, and Sprint 9.12 kept the two apart
// rather than overloading this one (ADR 0022). Rows and memberships only; the
// first thing to key on departments will be requester context, not routing.
model Department {
  id String @id @db.Uuid

  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name   String
  status String

  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  departmentMemberships DepartmentMembership[]
  invitations           Invitation[]

  @@unique([branchId, name])
  @@map("departments")
}

// An operational station is CONTEXT, never a principal (ADR 0016/0017): it
// authenticates nothing, holds no credential, and never appears as an actor.
// It is a registered place a request can name — the till, not the cashier.
model OperationalStation {
  id String @id @db.Uuid

  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  code String
  name String
  area String?

  // Who answers for the place, not who acts as it. SET NULL: losing the
  // responsible manager must never take the station down with them.
  responsibleMembershipId String?     @map("responsible_membership_id") @db.Uuid
  responsibleMembership   Membership? @relation(fields: [responsibleMembershipId], references: [id], onDelete: SetNull)

  status String

  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  @@unique([branchId, code])
  @@map("operational_stations")
}

// A SUPPORT TEAM is the operational group that resolves a ticket (ADR 0022).
// It is NOT a department: a department is the requester's organizational area
// and belongs to exactly one branch, which is why it cannot represent one
// central IT team serving every store.
//
// Organization-owned on purpose. Branch reach is expressed by the join below
// rather than by ownership, so one mechanism covers all four shapes the
// product needs: organization-wide, central, regional and branch-local.
model SupportTeam {
  id String @id @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Stable operator-facing key, unique per organization; never globally —
  // every organization may have an "it".
  code   String
  name   String
  status String

  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  members      SupportTeamMembership[]
  branchScopes SupportTeamBranch[]

  @@unique([organizationId, code])
  @@map("support_teams")
}

// Membership × team, and deliberately a DIFFERENT join from
// department_memberships: the person who fixes the till is not in Checkout.
// Visibility (tickets.read_team) derives from this one and never from that
// one.
model SupportTeamMembership {
  teamId String      @map("team_id") @db.Uuid
  team   SupportTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  membershipId String     @map("membership_id") @db.Uuid
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  @@id([teamId, membershipId])
  @@map("support_team_memberships")
}

// Team × branch. NO ROWS MEANS ORGANIZATION-WIDE — the absence is the
// meaning, not a missing configuration. Rows limit the team to exactly those
// branches, which is how a regional team over three of five stores is
// expressed without a second team per store.
model SupportTeamBranch {
  teamId String      @map("team_id") @db.Uuid
  team   SupportTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  @@id([teamId, branchId])
  @@map("support_team_branches")
}

// Membership × branch, the join ADR 0016 chose over a branch_id column: a
// regional manager covers several stores without duplicate memberships.
// Deliberately WITHOUT the scope qualifier column the ADR was unsure about
// (Sprint 9.5, D3): the role template carries the meaning — branch_manager ×
// branch set = manages; agent/requester × branch set = works at. The ADR
// amendment recording this outcome lands with the sprint's docs pass.
model BranchMembership {
  membershipId String     @map("membership_id") @db.Uuid
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  @@id([membershipId, branchId])
  @@map("branch_memberships")
}

model DepartmentMembership {
  membershipId String     @map("membership_id") @db.Uuid
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  departmentId String     @map("department_id") @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  @@id([membershipId, departmentId])
  @@map("department_memberships")
}

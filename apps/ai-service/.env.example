# ai-service — development defaults.
# Copy to .env (git-ignored) and replace the secret placeholder. Nx loads the
# sibling .env automatically; the Prisma CLI reads DATABASE_URL from the shell.
NODE_ENV=development
PORT=3009
LOG_LEVEL=info

# Owned database (ADR 0003), provisioned by infrastructure/postgres/init.
DATABASE_URL=postgresql://ai_service:helpdesk_local_only_ai@localhost:5433/helpdesk_ai

# Local RabbitMQ from compose.yaml; this service publishes
# ai.suggestion.created.v1 and consumes nothing.
RABBITMQ_URL=amqp://helpdesk:helpdesk_local_only_rabbit@localhost:5672

# MUST equal auth-service's JWT_ACCESS_SECRET: this service verifies the
# access tokens auth-service signs (shared HS256 secret — see SECURITY.md).
JWT_ACCESS_SECRET=replace-with-the-same-secret-auth-service-uses

# Ticket content is read from tickets-service with the CALLER's token
# (ADR 0011) — this URL is the only thing this service needs to know about it.
TICKETS_SERVICE_URL=http://localhost:3004

# Model provider: 'local' or 'gemini'.
#
# 'local' is a deterministic keyword-and-template provider: no network, no
# cost, same input -> same output (ADR 0010). It is the default here and the
# provider CI runs on, so the test suite needs no credential and no network.
#
# 'gemini' calls Google's Interactions API and requires GEMINI_API_KEY below.
# Selecting it means the ticket title, description, public thread, status,
# priority and category leave this machine and are sent to Google. Internal
# notes never are — they are dropped while the context is built (ADR 0011).
AI_PROVIDER=local

# Required ONLY when AI_PROVIDER=gemini; startup fails fast and names this
# variable if it is missing or empty. Get a key from Google AI Studio and put
# it in the git-ignored .env — NEVER here, and never in code, tests or docs.
GEMINI_API_KEY=

# gemini-3.5-flash is the step up if reply drafts need more quality. The
# free-tier claim for this default is dated and lives next to
# DEFAULT_GEMINI_MODEL in src/config/env.ts — one statement to re-check
# rather than two copies that drift apart.
GEMINI_MODEL=gemini-3.5-flash-lite

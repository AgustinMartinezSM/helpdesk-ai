// Persistence model for analytics-service: dashboard projections rebuilt
// from domain events (docs/architecture/data-ownership.md, option 3).
//
// ticket_snapshots keeps ONE row per ticket instead of incremental
// counters: under at-least-once delivery counters double-count, while a
// keyed snapshot with a last-writer-wins guard (last_event_at, enforced
// atomically in SQL by the repository) is naturally idempotent and
// tolerates out-of-order delivery. priority/created_at are nullable
// because a status-changed event may arrive before its ticket's created
// event; created later backfills them without clobbering newer status.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model TicketSnapshot {
  ticketId    String    @id @map("ticket_id") @db.Uuid
  status      String
  priority    String?
  createdAt   DateTime? @map("created_at") @db.Timestamptz(3)
  /// Set while the ticket sits in 'resolved'; cleared on any other status.
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz(3)
  /// Envelope occurredAt of the newest applied event — the LWW guard.
  lastEventAt DateTime  @map("last_event_at") @db.Timestamptz(3)

  /// Tenant this snapshot belongs to (ADR 0012). An opaque identifier, never
  /// a foreign key (ADR 0003). NOT NULL since the phase-7 enforcement: every
  /// projecting event carries its tenant, and a v2 event may still correct
  /// the stored value under the LWW guard.
  organizationId String @map("organization_id") @db.Uuid

  @@index([status])
  @@index([organizationId])
  @@map("ticket_snapshots")
}

/// One row per MEMBERSHIP EDGE, not per person (Sprint 10.7, ADR 0026).
///
/// It was keyed on user_id alone until then, with a nullable tenant that a
/// registration inserted and the first membership stamped. That made the
/// holding pen win every time — registration is what creates the bootstrap
/// membership, so its event always arrived first — and every real
/// organization counted approximately nobody.
///
/// The tenant is NOT NULL now, and the registration write path is gone rather
/// than adapted: this projection answers "how many people are in this
/// organization", and a row with no organization answers nothing. That closes
/// the last non-structural exemption from the phase-7 enforcement; only
/// helpdesk_audit.audit_events remains, and that one is permanent.
model UserSnapshot {
  userId String @map("user_id") @db.Uuid

  /// Tenant this membership belongs to (ADR 0012). An opaque identifier,
  /// never a foreign key (ADR 0003).
  organizationId String @map("organization_id") @db.Uuid

  /// When this person joined THIS organization — the membership's createdAt.
  /// It was called registeredAt while one row stood for one person, which
  /// stopped being true the moment a person could have several.
  joinedAt DateTime @map("joined_at") @db.Timestamptz(3)

  /// Membership status as last projected (Sprint 10.8). A free string, never
  /// an enum, for the reason the contracts give: the vocabulary is unfrozen,
  /// so freezing it here would turn settling it into a migration. The count
  /// asks for 'active' and anything else simply does not count, which is what
  /// makes an unknown status fail closed.
  ///
  /// NO DEFAULT on purpose. A default would let a row nobody meant to write
  /// count as a person.
  status String

  /// Payload timestamp of the newest applied membership fact — the LWW guard,
  /// the same role last_event_at plays for ticket_snapshots and updated_at
  /// plays for users-service's directory projection. It is what makes a
  /// replayed suspension harmless and why the row is never deleted.
  lastEventAt DateTime @map("last_event_at") @db.Timestamptz(3)

  /// Leads with organization_id even though the primary key leads with
  /// user_id: every aggregate filters on the tenant, which the composite key
  /// cannot serve. status trails it because the only query is
  /// "count active in this organization", and a leading-column index still
  /// serves the tenant-only grouping the operator script does.
  @@id([userId, organizationId])
  @@index([organizationId, status])
  @@map("user_snapshots")
}

// Persistence model for audit-service. The audit trail is append-only by
// design: the repository exposes no update or delete, and the primary key
// IS the event envelope id, which makes recording naturally idempotent
// under at-least-once delivery (INSERT ... ON CONFLICT DO NOTHING).
//
// payload is stored as opaque jsonb: this service is schema-on-read and
// must capture event types it has no contract for (ADR 0005 / sprint 7).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model AuditEvent {
  /// Envelope id straight from the bus — the idempotency key.
  id            String   @id @db.Uuid
  type          String
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(3)
  correlationId String?  @map("correlation_id")
  payload       Json
  recordedAt    DateTime @map("recorded_at") @db.Timestamptz(3)

  /// Tenant this event belongs to (ADR 0012). An opaque identifier, never a
  /// foreign key (ADR 0003).
  ///
  /// Every row that existed when the column was added was assigned the
  /// bootstrap organization by a backfill, because there was no other
  /// organization it could have been. Going forward the value is on the v2
  /// envelope, and the consumer starts persisting it in the phase that
  /// teaches the consumers to read v2 — until then new rows are null.
  ///
  /// The backfill is the only UPDATE this table will ever see. The trail is
  /// append-only to the application; a migration is not the application.
  organizationId String? @map("organization_id") @db.Uuid

  @@index([type, occurredAt])
  @@index([occurredAt])
  @@index([organizationId, occurredAt])
  @@map("audit_events")
}

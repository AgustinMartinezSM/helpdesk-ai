{
  "name": "@helpdesk-ai/tickets-service",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "prisma-generate",
          "^build"
        ],
        "options": {
          "command": "webpack-cli build",
          "env": {
            "NODE_ENV": "production"
          },
          "cwd": "apps/tickets-service"
        },
        "configurations": {
          "development": {
            "env": {
              "NODE_ENV": "development"
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/tickets-service/dist/package.json",
          "{workspaceRoot}/apps/tickets-service/dist/pnpm-lock.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/tickets-service/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@helpdesk-ai/tickets-service:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@helpdesk-ai/tickets-service:build:development"
          },
          "production": {
            "buildTarget": "@helpdesk-ai/tickets-service:build:production"
          }
        }
      },
      "test": {
        "dependsOn": [
          "prisma-generate"
        ],
        "options": {
          "passWithNoTests": true
        }
      },
      "typecheck": {
        "dependsOn": [
          "prisma-generate"
        ]
      },
      "prisma-generate": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/prisma/schema.prisma",
          "{projectRoot}/prisma.config.ts"
        ],
        "outputs": [
          "{projectRoot}/src/generated"
        ],
        "options": {
          "command": "prisma generate",
          "cwd": "apps/tickets-service"
        }
      },
      "test-integration": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "prisma-generate"
        ],
        "options": {
          "commands": [
            "prisma migrate deploy",
            "jest --config jest.integration.config.cts --runInBand"
          ],
          "parallel": false,
          "cwd": "apps/tickets-service",
          "env": {
            "DATABASE_URL": "postgresql://tickets_service:helpdesk_local_only_tickets@localhost:5433/helpdesk_tickets_test"
          }
        }
      }
    }
  },
  "dependencies": {
    "@helpdesk-ai/configuration": "workspace:*",
    "@helpdesk-ai/observability": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "prisma": "7.9.1"
  }
}

// Persistence model for tickets-service. Maps to PERSISTENCE shapes only;
// domain entities live in src/domain and are mapped inside the repository
// adapter (ADR 0004).
//
// requesterId / assigneeId / authorId / actorId are plain identifiers issued
// by auth-service — never cross-service foreign keys (ADR 0003).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TicketStatus {
  open
  in_progress
  resolved
  closed
}

enum TicketPriority {
  low
  medium
  high
  urgent
}

model Ticket {
  id          String         @id @db.Uuid
  title       String
  description String
  status      TicketStatus
  priority    TicketPriority
  category    String?
  requesterId String         @map("requester_id") @db.Uuid
  assigneeId  String?        @map("assignee_id") @db.Uuid
  createdAt   DateTime       @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @map("updated_at") @db.Timestamptz(3)

  /// Tenant this ticket belongs to (ADR 0012). An opaque identifier, never a
  /// foreign key — organizations live in another service's database
  /// (ADR 0003).
  ///
  /// NOT NULL since the phase-7 enforcement: every write takes the
  /// organization from the token, so the constraint is the net under
  /// behavior the code already refuses to get wrong.
  organizationId String @map("organization_id") @db.Uuid

  /// Branch this ticket was filed under (ADR 0016) — an opaque id validated
  /// against the branch_refs projection at creation, never a foreign key
  /// (ADR 0003). Nullable FOREVER, not until a backfill: a ticket without a
  /// branch is the eight-person shop with nothing to configure, a
  /// permanently legitimate state.
  branchId String? @map("branch_id") @db.Uuid

  /// Station the request came from. Context, never a principal (ADR 0016):
  /// this names a place, and requesterId keeps naming the person. Same
  /// permanent nullability as branchId.
  operationalStationId String? @map("operational_station_id") @db.Uuid

  comments TicketComment[]
  history  TicketHistoryEntry[]

  @@index([requesterId])
  @@index([assigneeId])
  @@index([status])
  /// The scoped list's exact shape: WHERE organization_id (optionally
  /// narrowed by requester/assignee/status), ORDER BY created_at.
  @@index([organizationId, createdAt])
  /// The branch-scoped list's shape: WHERE organization_id AND branch_id IN
  /// (the caller's branch set).
  @@index([organizationId, branchId])
  @@map("tickets")
}

/// Projection of organizations-service's branches (Sprint 9.5, D4). Ticket
/// creation is a hot path, so branch validation reads these local rows —
/// fed by branch.created/updated.v1 — instead of asking
/// organizations-service synchronously; ADR 0014's mutations-may-ask
/// exception deliberately does not apply. Rows are last-write-wins on the
/// event's own timestamp, and the id is opaque with no FK (ADR 0003).
model BranchRef {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String
  name           String
  status         String
  updatedAt      DateTime @map("updated_at") @db.Timestamptz(3)

  /// The picker's and the create-validation's shape: active branches of one
  /// tenant.
  @@index([organizationId, status])
  @@map("branch_refs")
}

/// Projection of organizations-service's operational stations, for the same
/// reason as BranchRef. organization_id is denormalized next to branch_id so
/// a scoped read never joins to know whose row it is reading.
model StationRef {
  id             String   @id @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String
  name           String
  area           String?
  status         String
  updatedAt      DateTime @map("updated_at") @db.Timestamptz(3)

  @@index([branchId])
  @@map("station_refs")
}

model TicketComment {
  id        String   @id @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  internal  Boolean
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  /// Denormalized from the parent ticket. Redundant while a comment can only
  /// belong to one ticket, and deliberate: a scoped query must not have to
  /// join to the ticket to know whose data it is reading. NOT NULL since the
  /// phase-7 enforcement.
  organizationId String @map("organization_id") @db.Uuid

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_comments")
}

model TicketHistoryEntry {
  id        String   @id @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  action    String
  detail    String?
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  /// Denormalized from the parent ticket, for the same reason as on a
  /// comment: a scoped read must not need a join to know whose row it is.
  /// NOT NULL since the phase-7 enforcement.
  organizationId String @map("organization_id") @db.Uuid

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_history")
}

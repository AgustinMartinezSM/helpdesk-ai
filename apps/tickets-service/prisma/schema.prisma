// Persistence model for tickets-service. Maps to PERSISTENCE shapes only;
// domain entities live in src/domain and are mapped inside the repository
// adapter (ADR 0004).
//
// requesterId / assigneeId / authorId / actorId are plain identifiers issued
// by auth-service — never cross-service foreign keys (ADR 0003).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TicketStatus {
  open
  in_progress
  resolved
  closed
}

enum TicketPriority {
  low
  medium
  high
  urgent
}

model Ticket {
  id          String         @id @db.Uuid
  title       String
  description String
  status      TicketStatus
  priority    TicketPriority
  category    String?
  requesterId String         @map("requester_id") @db.Uuid
  assigneeId  String?        @map("assignee_id") @db.Uuid
  createdAt   DateTime       @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @map("updated_at") @db.Timestamptz(3)

  /// Tenant this ticket belongs to (ADR 0012). An opaque identifier, never a
  /// foreign key — organizations live in another service's database
  /// (ADR 0003).
  ///
  /// NOT NULL since the phase-7 enforcement: every write takes the
  /// organization from the token, so the constraint is the net under
  /// behavior the code already refuses to get wrong.
  organizationId String @map("organization_id") @db.Uuid

  comments TicketComment[]
  history  TicketHistoryEntry[]

  @@index([requesterId])
  @@index([assigneeId])
  @@index([status])
  /// The scoped list's exact shape: WHERE organization_id (optionally
  /// narrowed by requester/assignee/status), ORDER BY created_at.
  @@index([organizationId, createdAt])
  @@map("tickets")
}

model TicketComment {
  id        String   @id @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  internal  Boolean
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  /// Denormalized from the parent ticket. Redundant while a comment can only
  /// belong to one ticket, and deliberate: a scoped query must not have to
  /// join to the ticket to know whose data it is reading. NOT NULL since the
  /// phase-7 enforcement.
  organizationId String @map("organization_id") @db.Uuid

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_comments")
}

model TicketHistoryEntry {
  id        String   @id @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  action    String
  detail    String?
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  /// Denormalized from the parent ticket, for the same reason as on a
  /// comment: a scoped read must not need a join to know whose row it is.
  /// NOT NULL since the phase-7 enforcement.
  organizationId String @map("organization_id") @db.Uuid

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_history")
}

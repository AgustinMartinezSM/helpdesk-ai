# Normalize all text files to LF in the repository.
# Checkout keeps LF as well, so tooling behaves identically on Windows, WSL, and CI.
* text=auto eol=lf

# Windows shell scripts must keep CRLF to execute correctly
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets — never diff or normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
